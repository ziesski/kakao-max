#!/usr/bin/expect -f
# Drive the setup wizard through a new Linux server install up to the Kakao account prompt, then answer it
# empty. Setup must stop there with no Kakao request. Usage: setup-to-account-prompt.exp <command> [args...]
encoding system utf-8
set timeout 900
spawn -noecho {*}$argv
expect {
  -re {Linux[^\n]*2 \(} { send "2\r" }
  timeout { puts stderr "install-check: no install choice prompt"; exit 10 }
}
expect {
  -ex {[Y/n]: } { send "\r" }
  timeout { puts stderr "install-check: no install confirmation"; exit 11 }
}
expect {
  -ex {(Enter: 8787): } { send "\r" }
  timeout { puts stderr "install-check: no port prompt"; exit 12 }
}
expect {
  -re {이메일: } { send "\r" }
  timeout { puts stderr "install-check: install did not reach the account prompt"; exit 13 }
}
expect {
  -re {비밀번호: } { send "\r" }
  timeout { puts stderr "install-check: no password prompt"; exit 14 }
}
expect {
  -re {Account input is empty or invalid} { }
  timeout { puts stderr "install-check: setup did not refuse the empty account input"; exit 15 }
}
expect eof
lassign [wait] pid spawnid os_error status
if {$status == 0} { puts stderr "install-check: setup exited 0 after empty account input"; exit 16 }
exit 0
